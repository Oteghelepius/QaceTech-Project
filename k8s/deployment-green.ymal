apiVersion: apps/v1
kind: Deployment
metadata:
  name: sinatra-blue
spec:
  replicas: 2
  selector:
    matchLabels:
      app: sinatra-blue
  template:
    metadata:
      labels:
        app: sinatra-blue
    spec:
      containers:
      - name: sinatra
        image: pius20/sinatra-cats:2.0.1
        ports:
        - containerPort: 4567
        resources: 
            limits: 
              cpu: 200m
              memory: 300Mi
            requests: 
              cpu: 100m
              memory: 200Mi
